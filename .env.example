# Dispersion prediction app configuration.
# Copy this file to .env and fill in all values for your deployment.

# Ports (published to host)
# NOTE: API_PORT and UMAMI_PORT are published for the upstream proxy and
# operator access respectively. Firewall both to trusted IPs only anyone
# who can reach them bypasses any proxy-level protections.
API_PORT=8084
FRONTEND_PORT=5184
REDIS_PORT=6384
UMAMI_PORT=3084

# Spatial database
DATABASE_HOST=postgis
DATABASE_PORT=5432
DATABASE_NAME=os
DATABASE_USER=bats
DATABASE_PASSWORD=bats

# Redis / Celery
# REDIS_PASSWORD must match the --requirepass value below in all Redis URLs.
# Generate with: openssl rand -hex 16
# Redis also runs with --maxmemory 200mb --maxmemory-policy volatile-lru
# (see docker-compose.yml); keep maxmemory below the 256MB container limit.
REDIS_PASSWORD=change-me-in-production
CELERY_BROKER_URL=redis://:change-me-in-production@redis:6384/0
CELERY_RESULT_BACKEND=redis://:change-me-in-production@redis:6384/1
AUTH_REDIS_URL=redis://:change-me-in-production@redis:6384/2

# Pipeline
PIPELINE_WORK_DIR=/tmp/circuitscape
PIPELINE_WORK_DIR_TTL_HOURS=24
PIPELINE_TIMEOUT=1800
PIPELINE_MAX_WORKERS=2
# Max jobs in flight (running + queued) globally; new submissions get
# HTTP 429 once reached. Size around PIPELINE_MAX_WORKERS * 2.
MAX_INFLIGHT_JOBS=8
PMTILES_DIR=/data/pmtiles

# CORS (origins allowed to call the API)
CORS_ORIGINS=http://localhost:5184,http://localhost:5173

# Umami analytics
UMAMI_URL=http://umami:3084
UMAMI_WEBSITE_ID=
UMAMI_ADMIN_USER=admin
UMAMI_ADMIN_PASSWORD=change-me-in-production
UMAMI_APP_SECRET=change-me-in-production
# Umami database (postgres-umami service). Generate a strong password with:
#   openssl rand -hex 16
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change-me-in-production  # MUST BE THE SAME AS UMAMI_DATABASE_URL PASSWORD BELOW
UMAMI_DB_NAME=umami
# Umami retention (daily celery-beat prune task; Umami has no built-in
# retention). Sizing: ~1-2KB per event row, so 180 days of...
#   100 events/day  ≈ ~35MB      1k events/day  ≈ ~350MB      10k events/day ≈ ~3.5GB
# Set UMAMI_DATABASE_URL empty to disable pruning.
UMAMI_DATABASE_URL=postgresql://umami:change-me-in-production@postgres-umami:5432/umami
UMAMI_RETENTION_DAYS=180

# Secrets
ANALYTICS_HASH_SECRET=change-me-in-production

# Optional API flags (defaults shown; uncomment to override)
LOG_LEVEL=INFO
MAX_PIXEL_DIMENSION=2000
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_RATE_LIMIT_PER_MINUTE=10
ANALYTICS_RATE_LIMIT_PER_MINUTE=30
# Dedup fingerprint + result lookup lifetime. Must stay >= the time results
# are servable (24h default) or identical resubmissions can recycle a work
# dir still in use. Rarely needs changing.
JOB_CACHE_TTL_SECONDS=86400
