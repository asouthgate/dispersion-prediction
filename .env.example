# Dispersion prediction app configuration.
# Copy this file to .env and fill in all values for your deployment.

# Ports (published to host)
API_PORT=8084
FRONTEND_PORT=5184
REDIS_PORT=6384
UMAMI_PORT=3084

# Spatial database
DATABASE_HOST=postgis
DATABASE_PORT=5432
DATABASE_NAME=os
DATABASE_USER=bats
DATABASE_PASSWORD=bats

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6384/0
CELERY_RESULT_BACKEND=redis://redis:6384/1
AUTH_REDIS_URL=redis://redis:6384/2

# Pipeline
PIPELINE_WORK_DIR=/tmp/circuitscape
PIPELINE_WORK_DIR_TTL_HOURS=24
PIPELINE_TIMEOUT=1800
PIPELINE_MAX_WORKERS=2
PMTILES_DIR=/data/pmtiles

# CORS (origins allowed to call the API)
CORS_ORIGINS=http://localhost:5184,http://localhost:5173

# Umami analytics
UMAMI_URL=http://umami:3084
UMAMI_WEBSITE_ID=
UMAMI_ADMIN_USER=admin
UMAMI_ADMIN_PASSWORD=umami
UMAMI_APP_SECRET=change-me-in-production

# Secrets
ANALYTICS_HASH_SECRET=change-me-in-production

# Optional API flags
# LOG_LEVEL=INFO
# MAX_PIXEL_DIMENSION=2000
# AUTH_TOKEN_TTL_SECONDS=86400
# AUTH_RATE_LIMIT_PER_MINUTE=10
