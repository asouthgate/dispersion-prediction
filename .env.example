# PostgreSQL 
DATABASE_HOST=localhost
DATABASE_NAME=os
DATABASE_PORT=5432
DATABASE_USER=bats
DATABASE_PASSWORD=bats

# Secrets used for analytics
UMAMI_APP_SECRET=change-me-in-production
ANALYTICS_HASH_SECRET=change-me-in-production

# CORS
CORS_ORIGINS=https://your-domain.com

# Celery broker / result backend (Redis)
# Can remain default for single-node deployment
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Redis URL used for auth token storage.
# Can remain default for single-node deployment
AUTH_REDIS_URL=redis://redis:6379/2

# Auto-cleanup: work directories older than this many hours are deleted
# by the periodic celery task (runs every hour).
PIPELINE_WORK_DIR_TTL_HOURS=24

# Maximum time (seconds) a single pipeline job is allowed to run.
PIPELINE_TIMEOUT=1800

# Number of concurrent pipeline workers.
PIPELINE_MAX_WORKERS=4

# Anallytics
# Internal URL the API uses to talk to Umami. Uses Docker DNS.
# Keep the default unless you run Umami on a separate host.
UMAMI_URL=http://umami:3000

# Pre-created Umami website ID. Leave blank to let the API auto-discover
# or create the website on first startup.
UMAMI_WEBSITE_ID=

# Umami admin credentials (used by the API to create the analytics
# website if UMAMI_WEBSITE_ID is not provided).
UMAMI_ADMIN_USER=admin
UMAMI_ADMIN_PASSWORD=umami
