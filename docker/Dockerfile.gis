FROM postgres:16-bookworm

# `postgis` (the metapackage) provides shp2pgsql/raster2pgsql, which the seed
# script needs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-16-postgis-3 \
        postgresql-16-postgis-3-scripts \
        postgis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY test/data/seed/seed-test-data.sh /docker-entrypoint-initdb.d/00-seed.sh
RUN chmod +x /docker-entrypoint-initdb.d/00-seed.sh