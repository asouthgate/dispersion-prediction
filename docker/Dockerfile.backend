FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    g++ \
    gettext-base \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libpq-dev \
    libuv1 \
    make \
    postgresql-client \
    python3 \
    python3-pip \
    python3-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*


WORKDIR /app


RUN curl -fsSL https://install.julialang.org | sh -s -- -y
ENV PATH="/root/.juliaup/bin:${PATH}"
COPY docker/JuliaProject.toml /opt/julia/
RUN julia -e 'using Pkg; Pkg.activate("/opt/julia"); Pkg.instantiate()'

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

COPY api/requirements.txt /tmp/
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /app
COPY api/ /app/api/
COPY scripts/ /app/scripts/
COPY docker/batapp/bats.cfg.template /opt/bats.cfg.template

COPY test/ /app/test/

COPY frontend/wasm-connectivity/src/ /app/frontend/wasm-connectivity/src/
COPY frontend/wasm-connectivity/Cargo.toml /app/frontend/wasm-connectivity/Cargo.toml
COPY frontend/wasm-connectivity/Cargo.lock /app/frontend/wasm-connectivity/Cargo.lock
WORKDIR /app/frontend/wasm-connectivity
RUN cargo build --release --features bin --bin resistance-pipeline \
    && cp target/release/resistance-pipeline /usr/local/bin/
WORKDIR /app


ENV PIPELINE_WORK_DIR=/tmp/circuitscape
RUN mkdir -p "$PIPELINE_WORK_DIR"

EXPOSE 8000

COPY docker/backend-entrypoint.sh /opt/backend-entrypoint.sh
RUN chmod +x /opt/backend-entrypoint.sh
ENTRYPOINT ["/opt/backend-entrypoint.sh"]
