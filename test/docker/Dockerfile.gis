FROM postgis/postgis:13-3.1

RUN apt-get update && apt-get install -y --no-install-recommends postgis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY test/data/seed/gis/ /seed-data/gis/
COPY test/data/seed/seed-test-data.sh /docker-entrypoint-initdb.d/00-seed.sh
RUN chmod +x /docker-entrypoint-initdb.d/00-seed.sh