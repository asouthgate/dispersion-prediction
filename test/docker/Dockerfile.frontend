FROM node:22-alpine AS builder
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./frontend/
COPY --from=gsbio package.json package-lock.json ./gsbio-engine/
RUN cd frontend && npm install

COPY --from=gsbio . ./gsbio-engine/
COPY frontend/ ./frontend/
RUN cd gsbio-engine && npm run build

WORKDIR /app/frontend
RUN npm run build

FROM nginx:alpine
COPY test/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
